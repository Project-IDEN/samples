# Where people's browsers reach IDEN. Must equal IDEN's IDEN_ISSUER exactly:
# every token's `iss` is checked against it.
IDEN_ISSUER=http://localhost:8000

# Where this container reaches IDEN. Only differs from the issuer because
# `localhost` inside a container is the container itself.
IDEN_INTERNAL_URL=http://host.docker.internal:8000

# Where people's browsers reach the playground. The redirect URI registered in
# IDEN is this plus /callback; the post-logout redirect URI is this plus /.
PLAYGROUND_URL=http://localhost:5100

# The client registered in IDEN for the playground.
PLAYGROUND_CLIENT_ID=playground
# Leave empty if you registered a public client.
PLAYGROUND_CLIENT_SECRET=
