# The one place the door panel's settings live: `pnpm dev`, `pnpm seed` and
# `docker compose` all read this file.

# IDEN's issuer URL. The browser goes there to sign in, this server calls it
# directly, and every token's `iss` must equal it exactly.
IDEN_ISSUER=https://iden.example.com

# Where people's browsers reach the panel. IDEN's server must reach it too, at
# /backchannel-logout, to lock the panel when an IDEN session ends.
DOOR_PANEL_URL=http://doors.example.com:5200

# Written by `pnpm seed` when it registers the client.
DOOR_PANEL_CLIENT_SECRET=

# For `pnpm seed`: an administrator's access token from the IDEN dashboard.
# It lasts ten minutes; paste a fresh one before each run.
ADMIN_TOKEN=

# Optional; uncomment to change.
# Seconds untouched before the panel signs out. 0 turns it off: do that for a
# presented demo.
# DOOR_PANEL_IDLE_SECONDS=60
# Alice's password when the seed creates her (12+ characters). Unset, IDEN
# generates one and the seed prints it once.
# DEMO_PASSWORD=
# DOOR_PANEL_CLIENT_ID=door-panel
# BUILDING_AUDIENCE=https://building.example/doors
