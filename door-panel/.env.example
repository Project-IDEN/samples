# IDEN's issuer URL. The browser goes there to sign in, this server calls it
# directly, and every token's `iss` must equal it exactly.
IDEN_ISSUER=https://iden.example.com

# Where people's browsers reach the panel. IDEN's server must reach it too, at
# /backchannel-logout, to lock the panel when an IDEN session ends.
DOOR_PANEL_URL=http://doors.example.com:5200

# The client scripts/seed.mjs registers. It prints the secret once.
DOOR_PANEL_CLIENT_ID=door-panel
DOOR_PANEL_CLIENT_SECRET=

# Must equal the audience of the "building" API in IDEN.
BUILDING_AUDIENCE=https://building.example/doors

# Sign the panel out after this many seconds untouched. 0 turns it off.
DOOR_PANEL_IDLE_SECONDS=60
